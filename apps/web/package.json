    "mocks:init": "msw init public --save"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@needgrid/shared": "workspace:*",
    "@paypal/react-paypal-js": "10.6.0",
    "@tanstack/react-query": "5.104.2",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
