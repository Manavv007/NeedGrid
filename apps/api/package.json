{
  "name": "@needgrid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db/index.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:money": "tsx --env-file-if-exists=.env src/money/checkMoney.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed/index.ts",
    "evals": "tsx --env-file-if-exists=.env src/ai/evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.106",
    "@channel3/sdk": "4.5.0",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@needgrid/shared": "workspace:*",
    "ai": "7.0.154",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
