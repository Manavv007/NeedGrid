# NeedGrid environment variables. Copy the API block to apps/api/.env and the Web block to apps/web/.env.
# Never commit real values. Every developer uses their OWN Neon branch, PayPal sandbox app and Gemini key.

# ---- API (apps/api/.env) ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Neon POOLED connection string for your own branch
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/needgrid?sslmode=require
# Separate Neon branch or local Postgres (with pgvector) for DB tests
TEST_DATABASE_URL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required from Phase 4 (webhooks); each sandbox app has its own
PAYPAL_WEBHOOK_ID=
# Item category DONATION needs a PayPal account approved for donations (else 403). Keep false in sandbox.
PAYPAL_DONATION_ITEMS=false
# Sandbox-only override of the 15-minute donation hold (e.g. 60 for bug-bash testing)
HOLD_SECONDS=
# Comma-separated list of allowed browser origins (http://localhost:5173 is always allowed)
WEB_ORIGIN=http://localhost:5173
# Demo staff passcode for the first seeded org (public by design, sandbox only)
STAFF_DEMO_KEY=harbor-demo-2026
# Cloud name of the team Cloudinary account (images from any other host are rejected)
CLOUDINARY_CLOUD_NAME=
# B: AI and products (optional at boot; B's routes return 503 when missing)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHANNEL3_API_KEY=
DASHBOARD_HMAC_SECRET=
# P2
RESEND_API_KEY=

# ---- Web (apps/web/.env) — VITE_* values are PUBLIC (baked into the bundle) ----
VITE_API_URL=http://localhost:3000
VITE_USE_MOCKS=false
# Client id of the same sandbox app as PAYPAL_CLIENT_ID
VITE_PAYPAL_CLIENT_ID=
VITE_CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset, folder "needgrid"
VITE_CLOUDINARY_UPLOAD_PRESET=
# B, from Nov 2
VITE_AG_STUDIO_LICENSE=
# The "Try the staff console" button
VITE_DEMO_STAFF_KEY=harbor-demo-2026
